generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                      String            @id @default(uuid())
  role                    AdminRole         @default(SUB)
  name                    String
  email                   String            @unique
  password                String
  isActive                Boolean           @default(true)
  permissions             AdminPermission[] @default([])
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  bannersCreated          Banner[]          @relation("BannerCreatedBy")
  cmsPagesUpdated         CmsPage[]         @relation("CmsPageUpdatedBy")
  cmsRevisionsCreated     CmsPageRevision[] @relation("CmsRevisionCreatedBy")
  coursesManaged          Course[]          @relation("InstructorCourses")
  reviewedReports         MessageReport[]   @relation("ReviewedByAdmin")
  platformSettingsUpdated PlatformSetting[]
  supportMessages         SupportMessage[]  @relation("AdminSupportMessages")
  assignedSupportTickets  SupportTicket[]   @relation("AssignedSupportTickets")
  reviewedTestimonials    Testimonial[]     @relation("ReviewedByAdmin")

  @@index([email])
  @@index([role])
}

model User {
  id                String                @id @default(uuid())
  phoneNumber       String                @unique
  name              String?
  password          String?
  email             String?               @unique
  isEmailVerified   Boolean               @default(false)
  expoPushToken     String?
  avatarMediaId     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  aiChatMessages    AiChatMessage[]
  certificates      Certificate[]
  chatConversations ChatConversation[]
  communityMessages CommunityMessage[]
  enrollments       Enrollment[]
  progress          LessonProgress[]
  reportsFiled      MessageReport[]       @relation("ReportedBy")
  notifications     Notification[]
  payments          Payment[]
  quizAttempts      QuizAttempt[]
  referredBy        Referral?             @relation("RefereeUser")
  referralsMade     Referral[]            @relation("ReferrerUser")
  referralCode      ReferralCode?
  reviews           Review[]
  supportMessages   SupportMessage[]      @relation("UserSupportMessages")
  supportTickets    SupportTicket[]
  testimonials      Testimonial[]
  transactions      Transaction[]
  avatar            MediaAsset?           @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  address           UserAddress?
  educationDetails  UserEducationDetails?
  personalDetails   UserPersonalDetails?
  preferences       UserPreferences?
  wallet            Wallet?
  wishlistItems     Wishlist[]

  @@index([phoneNumber])
}

model UserPreferences {
  id        String   @id @default(uuid())
  userId    String   @unique
  language  String
  subjects  String[]
  goals     String[]
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                   String             @id @default(uuid())
  title                String
  description          String
  subject              String
  language             String
  goals                String[]
  price                Decimal            @default(0) @db.Decimal(10, 2)
  discountPrice        Decimal?           @db.Decimal(10, 2)
  discountValidUntil   DateTime?
  isFree               Boolean            @default(false)
  isPublished          Boolean            @default(false)
  thumbnailMediaId     String?
  instructorId         String?
  accessDurationDays   Int?
  scheduledPublishDate DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  chatConversations    ChatConversation[]
  communityMessages    CommunityMessage[]
  instructor           Admin?             @relation("InstructorCourses", fields: [instructorId], references: [id])
  thumbnail            MediaAsset?        @relation("CourseThumbnail", fields: [thumbnailMediaId], references: [id])
  enrollments          Enrollment[]
  modules              Module[]
  reviews              Review[]
  testimonials         Testimonial[]
  wishlistItems        Wishlist[]

  @@index([subject])
  @@index([language])
  @@index([discountValidUntil])
}

model Module {
  id                   String    @id @default(uuid())
  courseId             String
  title                String
  order                Int
  scheduledPublishDate DateTime?
  lessons              Lesson[]
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Lesson {
  id                   String             @id @default(uuid())
  moduleId             String
  title                String
  order                Int
  durationSec          Int?
  unlockAfterDays      Int?
  isFreePreview        Boolean            @default(false)
  scheduledPublishDate DateTime?
  aiChatMessages       AiChatMessage[]
  chatConversations    ChatConversation[]
  module               Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contents             LessonContent[]
  progress             LessonProgress[]
  quiz                 Quiz?

  @@unique([moduleId, order])
  @@index([moduleId])
}

model LessonContent {
  id        String            @id @default(uuid())
  lessonId  String
  type      LessonContentType
  order     Int
  title     String?
  body      String?
  mediaId   String?
  createdAt DateTime          @default(now())
  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  media     MediaAsset?       @relation(fields: [mediaId], references: [id])

  @@unique([lessonId, order])
  @@index([lessonId])
}

model Enrollment {
  id                 String           @id @default(uuid())
  userId             String
  courseId           String
  status             EnrollmentStatus @default(ACTIVE)
  couponCode         String?
  enrolledAt         DateTime         @default(now())
  accessDurationDays Int?
  expiresAt          DateTime?
  completedAt        DateTime?
  certificate        Certificate?
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment            Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([expiresAt])
}

model Payment {
  id              String          @id @default(uuid())
  userId          String?
  enrollmentId    String?         @unique
  provider        PaymentProvider
  providerOrderId String?
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("INR")
  status          PaymentStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  enrollment      Enrollment?     @relation(fields: [enrollmentId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])
  transactions    Transaction[]

  @@index([userId])
  @@index([status])
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String?
  paymentId           String?
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  amount              Decimal           @db.Decimal(10, 2)
  currency            String            @default("INR")
  providerReferenceId String?
  failureReason       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  payment             Payment?          @relation(fields: [paymentId], references: [id])
  user                User?             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([paymentId])
  @@index([type])
  @@index([status])
}

model LessonProgress {
  id              String         @id @default(uuid())
  userId          String
  lessonId        String
  status          ProgressStatus @default(NOT_STARTED)
  watchTimeSec    Int            @default(0)
  lastPositionSec Int            @default(0)
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt
  lesson          Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Certificate {
  id                 String      @id @default(uuid())
  userId             String
  enrollmentId       String      @unique
  issuedAt           DateTime    @default(now())
  certificateMediaId String?
  certificateMedia   MediaAsset? @relation("CertificateMedia", fields: [certificateMediaId], references: [id])
  enrollment         Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Quiz {
  id        String        @id @default(uuid())
  lessonId  String        @unique
  title     String
  questions Question[]
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts  QuizAttempt[]
}

model Question {
  id              String @id @default(uuid())
  quizId          String
  text            String
  options         Json
  correctOptionId String
  order           Int
  quiz            Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  answers     Json
  score       Int
  attemptedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model AiChatMessage {
  id         String     @id @default(uuid())
  userId     String
  lessonId   String?
  sender     ChatSender
  message    String
  mode       String?
  escalated  Boolean    @default(false)
  creditCost Int        @default(0)
  createdAt  DateTime   @default(now())
  lesson     Lesson?    @relation(fields: [lessonId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  courseId  String?
  lessonId  String?
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  course    Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@index([courseId])
  @@index([lessonId])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  role           ChatRole
  content        String
  fromCache      Boolean          @default(false)
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  provider       String?
  model          String?
  promptVersion  String?
  creditCost     Int              @default(0)
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CommunityMessage {
  id        String          @id @default(uuid())
  courseId  String
  userId    String?
  message   String
  createdAt DateTime        @default(now())
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id])
  reports   MessageReport[]

  @@index([courseId])
  @@index([userId])
}

model MessageReport {
  id           String           @id @default(uuid())
  messageId    String
  reportedById String
  reason       String?
  status       ReportStatus     @default(PENDING)
  reviewedById String?
  createdAt    DateTime         @default(now())
  message      CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedBy   User             @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  reviewedBy   Admin?           @relation("ReviewedByAdmin", fields: [reviewedById], references: [id])

  @@index([messageId])
  @@index([reviewedById])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  referralCredits Int      @default(5)
  aiCredits       Int      @default(0)
  balanceCredits  Int      @default(5)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id                        String                 @id @default(uuid())
  type                      MediaType
  url                       String
  mimeType                  String
  storageKey                String                 @unique
  provider                  String
  bucket                    String?
  region                    String?
  sizeBytes                 Int?
  uploadStrategy            UploadStrategy         @default(SINGLE_PART)
  uploadStatus              FileStatus             @default(INITIATED)
  uploadId                  String?
  createdAt                 DateTime               @default(now())
  certificates              Certificate[]          @relation("CertificateMedia")
  coursesWithThumbnail      Course[]               @relation("CourseThumbnail")
  lessonContents            LessonContent[]
  usersWithAvatar           User[]                 @relation("UserAvatar")
  classXIIResultFor         UserEducationDetails[] @relation("ClassXIIResultFile")
  classXResultFor           UserEducationDetails[] @relation("ClassXResultFile")
  collegeResultFor          UserEducationDetails[] @relation("CollegeResultFile")
  aadhaarFileFor            UserPersonalDetails[]  @relation("AadhaarFile")
  panFileFor                UserPersonalDetails[]  @relation("PanFile")
  signatureFor              UserPersonalDetails[]  @relation("SignatureImage")
  supportMessageAttachments SupportMessage[]       @relation("SupportMessageAttachments")
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

model Referral {
  id                  String         @id @default(uuid())
  referrerId          String
  refereeId           String         @unique
  codeUsed            String
  status              ReferralStatus @default(PENDING)
  rewardAmount        Decimal?       @db.Decimal(10, 2)
  refereeRewardAmount Decimal?       @db.Decimal(10, 2)
  rewardedAt          DateTime?
  createdAt           DateTime       @default(now())
  referee             User           @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: Cascade)
  referrer            User           @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
}

model ReferralConfig {
  id                    String   @id @default("default")
  referrerRewardCredits Int      @default(10)
  refereeRewardCredits  Int      @default(5)
  minPurchaseAmount     Decimal  @default(0) @db.Decimal(10, 2)
  isEnabled             Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model Testimonial {
  id           String            @id @default(uuid())
  userId       String
  courseId     String?
  content      String
  rating       Int?
  status       TestimonialStatus @default(PENDING)
  reviewedById String?
  isFeatured   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  course       Course?           @relation(fields: [courseId], references: [id])
  reviewedBy   Admin?            @relation("ReviewedByAdmin", fields: [reviewedById], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([reviewedById])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel
  title     String
  body      String
  read      Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlatformSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id])
}

model CourseCategoryConfig {
  id        String   @id @default(uuid())
  type      String
  value     String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AICreditPackage {
  id           String   @id @default(uuid())
  name         String
  price        Decimal  @db.Decimal(10, 2)
  credits      Int
  bonusCredits Int      @default(0)
  description  String?
  popular      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model UserAddress {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  permanentAddress             String?
  permanentAddressPincode      String?
  correspondenceAddress        String?
  correspondenceAddressPincode String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPersonalDetails {
  id               String      @id @default(uuid())
  userId           String      @unique
  dateOfBirth      DateTime?
  gender           Gender?
  bloodGroup       String?
  aadhaarNumber    String?
  aadhaarFileId    String?
  panNumber        String?
  panFileId        String?
  signatureImageId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  aadhaarFile      MediaAsset? @relation("AadhaarFile", fields: [aadhaarFileId], references: [id])
  panFile          MediaAsset? @relation("PanFile", fields: [panFileId], references: [id])
  signatureImage   MediaAsset? @relation("SignatureImage", fields: [signatureImageId], references: [id])
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserEducationDetails {
  id                   String      @id @default(uuid())
  userId               String      @unique
  collegeName          String?
  collegeMarks         Decimal?    @db.Decimal(5, 2)
  collegeResultFileId  String?
  schoolName           String?
  marksClassXII        Decimal?    @db.Decimal(5, 2)
  classXIIResultFileId String?
  marksClassX          Decimal?    @db.Decimal(5, 2)
  classXResultFileId   String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  classXIIResultFile   MediaAsset? @relation("ClassXIIResultFile", fields: [classXIIResultFileId], references: [id])
  classXResultFile     MediaAsset? @relation("ClassXResultFile", fields: [classXResultFileId], references: [id])
  collegeResultFile    MediaAsset? @relation("CollegeResultFile", fields: [collegeResultFileId], references: [id])
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id              String           @id @default(uuid())
  ticketNumber    String           @unique
  userId          String?
  subject         String
  category        TicketCategory   @default(OTHER)
  priority        TicketPriority   @default(MEDIUM)
  status          TicketStatus     @default(OPEN)
  assignedAdminId String?
  lastRepliedAt   DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        SupportMessage[]
  assignedAdmin   Admin?           @relation("AssignedSupportTickets", fields: [assignedAdminId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([assignedAdminId])
}

model SupportMessage {
  id             String           @id @default(uuid())
  ticketId       String
  senderType     TicketSenderType
  senderUserId   String?
  senderAdminId  String?
  message        String
  isInternalNote Boolean          @default(false)
  createdAt      DateTime         @default(now())
  senderAdmin    Admin?           @relation("AdminSupportMessages", fields: [senderAdminId], references: [id])
  senderUser     User?            @relation("UserSupportMessages", fields: [senderUserId], references: [id])
  ticket         SupportTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments    MediaAsset[]     @relation("SupportMessageAttachments")

  @@index([ticketId])
}

model CmsPage {
  id              String            @id @default(uuid())
  slug            String            @unique
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean           @default(true)
  version         Int               @default(1)
  updatedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  updatedBy       Admin?            @relation("CmsPageUpdatedBy", fields: [updatedById], references: [id])
  revisions       CmsPageRevision[]

  @@index([slug])
  @@index([isPublished])
}

model CmsPageRevision {
  id          String   @id @default(uuid())
  pageId      String
  title       String
  content     String
  version     Int
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   Admin?   @relation("CmsRevisionCreatedBy", fields: [createdById], references: [id])
  page        CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([version])
}

model Banner {
  id           String   @id @default(uuid())
  title        String
  thumbnailUrl String
  linkUrl      String
  description  String?
  badgeText    String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    Admin?   @relation("BannerCreatedBy", fields: [createdById], references: [id])

  @@index([isActive])
  @@index([displayOrder])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AdminRole {
  SUPER
  SUB
}

enum AdminPermission {
  COURSES_READ
  COURSES_WRITE
  VERIFICATIONS_READ
  VERIFICATIONS_WRITE
  USERS_READ
  USERS_WRITE
  PAYMENTS_READ
  SUPPORT_READ
  SUPPORT_WRITE
  COMMUNITY_READ
  COMMUNITY_WRITE
  SETTINGS_READ
  SETTINGS_WRITE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum LessonContentType {
  VIDEO
  PDF
  TEXT
  QUIZ
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ChatSender {
  USER
  AI
  INSTRUCTOR
}

enum NotificationChannel {
  WHATSAPP
  SMS
  IN_APP
}

enum NotificationType {
  ENROLLMENT_CONFIRMATION
  COURSE_REMINDER
  NEW_CONTENT
  PROGRESS_NUDGE
  LIVE_SESSION
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum TransactionType {
  PAYMENT
  REFUND
  REFERRAL_CREDIT
  REFERRAL_REDEMPTION
  AI_CREDIT_USAGE
  PROMOTIONAL_CREDIT
  AI_CREDIT_PURCHASE
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  CERTIFICATE
  BADGE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReferralStatus {
  PENDING
  SIGNED_UP
  REWARDED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadStrategy {
  SINGLE_PART
  MULTIPART
}

enum FileStatus {
  INITIATED
  UPLOADING
  COMPLETED
  FAILED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum TicketCategory {
  TECHNICAL
  BILLING_PAYMENT
  COURSE_ACCESS
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketSenderType {
  USER
  ADMIN
}
