generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id    String    @id @default(uuid())
  role  AdminRole @default(SUB)
  name  String
  email String    @unique
}

model User {
  id          String  @id @default(uuid())
  phoneNumber String  @unique
  name        String?
  email       String? @unique
  avatarUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdminRole {
  SUPER
  SUB
}
