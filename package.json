{
    "name": "lms-platform-backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development npx nodemon -r module-alias/register src/index.ts",
        "build": "prisma generate && tsc && tsc-alias",
        "vercel-build": "(prisma db push || true) && prisma generate && tsc && tsc-alias",
        "db:push": "prisma db push",
        "db:sync": "prisma db push && prisma generate",
        "postinstall": "prisma generate",
        "start": "cross-env NODE_ENV=production node -r module-alias/register dist/index.js",
        "seed": "npx tsx prisma/seed.ts",
        "backfill-referrals": "npx ts-node -r ./src/config/moduleAlias.ts src/scripts/backfillReferrals.ts",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "prisma": {
        "seed": "npx tsx prisma/seed.ts"
    },
    "_moduleAliases": {
        "@": "dist"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1109.0",
        "@aws-sdk/s3-request-presigner": "^3.1109.0",
        "@google/generative-ai": "^0.24.1",
        "@imagekit/nodejs": "^7.11.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "7.9.1",
        "argon2": "0.45.1",
        "cloudinary": "^2.10.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cross-env": "10.1.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "http-status": "^2.1.0",
        "ioredis": "6.0.0",
        "jsonwebtoken": "^9.0.3",
        "module-alias": "^2.3.4",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "nodemailer": "9.0.5",
        "pg": "^8.23.0",
        "razorpay": "^2.9.8",
        "ts-node": "^10.9.2",
        "twilio": "^6.1.0",
        "typescript": "^5.9.3",
        "uuid": "^14.0.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "ws": "^8.21.3",
        "zod": "4.4.3"
    },
